{
  "name": "rest-express",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "proto:gen": "npx pbjs -t static-module -w es6 --es6 -o shared/generated/proto-bundle.js shared/proto/common.proto shared/proto/conversations.proto shared/proto/models.proto shared/proto/knowledge.proto && npx pbts -o shared/generated/proto-bundle.d.ts shared/generated/proto-bundle.js",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "sbom": "cyclonedx-npm --package-lock-only --output-reproducible --output-file reports/sbom.cdx.json",
    "smoke:prod": "node script/smoke-prod.mjs",
    "live:docker": "node script/live-local-docker.mjs",
    "verify": "npm run check && npm run test:unit -- --run && npm run test:coverage && npm run build && npm run audit && npm run sbom && npm run smoke:prod",
    "temporal:install": "npm install @temporalio/client @temporalio/worker @temporalio/workflow @temporalio/activity",
    "temporal:worker": "RUN_TEMPORAL_WORKER=1 tsx server/temporalWorker.ts",
    "temporal:verify": "echo 'Start the stack first: docker compose up -d && npm run temporal:install && npm run temporal:worker' && echo 'Then run: npx vitest run tests/integration/temporal-durable-live.test.ts'",
    "temporal:proof": "TEMPORAL_ADDRESS=localhost:7233 tsx scripts/temporal-proof-run.ts",
    "temporal:namespace": "docker exec codex-ultra-computer-temporal-1 sh -c 'tctl --address $(hostname -i | awk \"{print $1}\"):7233 namespace register --retention 1 default 2>/dev/null || echo already-registered'"
  },

FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl git jq \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global tsx@4.23.1 && npm cache clean --force
WORKDIR /workspace
# The engine additionally enforces readonly root, no network/caps, CPU/memory/PID limits.
CMD ["sleep", "infinity"]

# Ultra Computer environment
# Copy to .env, generate new secrets, and never commit the populated file.

# Application -----------------------------------------------------------------
NODE_ENV=production
APP_PORT=5000
GRPC_HOST_PORT=50051
DATABASE_PATH=/app/data/ultra_computer.db
# Optional surfaces are off by default. This value applies to direct process
# launches; standard Compose intentionally does not forward the opt-in. Add an
# explicit service mapping only after reviewing evidence and requirements.
ULTRA_EXPERIMENTAL=0
ALLOWED_ORIGIN=https://ultra.example.com
TRUST_PROXY=1

# Generate independently with: npm run gen:key
# ULTRA_API_KEY must be at least 32 characters.
ULTRA_API_KEY=
# ENCRYPTION_KEY must be exactly 64 hexadecimal characters.
ENCRYPTION_KEY=

# Shell execution fails closed when Docker isolation is unavailable. Host-shell
# execution is forbidden in production. For deliberate local development only:
# ALLOW_HOST_SHELL=true

# Governed outbound HTTP -------------------------------------------------------
OUTBOUND_HTTP_TIMEOUT_MS=15000
OUTBOUND_HTTP_MAX_REDIRECTS=3
OUTBOUND_HTTP_MAX_RESPONSE_BYTES=10485760
# Exact local/private hostnames or IP addresses approved for egress, separated
# by commas. Leave empty unless a specific local integration requires access.
ULTRA_LOCAL_EGRESS_ALLOWLIST=
# Keep false in production. Set true only for an explicitly approved HTTP-only
# endpoint whose transport risk has been documented.
ULTRA_ALLOW_INSECURE_HTTP=false

# Durable execution -----------------------------------------------------------
# Optional isolated Temporal sample proof only. The normal application path
# uses Redis/BullMQ and does not dispatch messages through Temporal.
TEMPORAL_DB_PASSWORD=
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=ultra-computer
# When running services outside Compose:
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Webhooks are optional. An unconfigured webhook endpoint rejects requests.
SLACK_SIGNING_SECRET=
GMAIL_PUSH_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Cloudflare Tunnel ------------------------------------------------------------
# Only passed when starting the explicit tunnel profile:
# docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Cache persistence ------------------------------------------------------------
# REDIS_CACHE_PERSIST=true

# Browser pool ----------------------------------------------------------------
# BROWSER_POOL_SIZE=2

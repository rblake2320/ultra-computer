FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS sandbox-base
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl git jq \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/ultra-interpreter
COPY sandbox-runtime/package.json sandbox-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
ENV PATH="/opt/ultra-interpreter/node_modules/.bin:${PATH}"
WORKDIR /workspace
# The engine additionally enforces readonly root, no network/caps, CPU/memory/PID limits.
CMD ["sleep", "infinity"]

FROM sandbox-base AS openshell
RUN mkdir -p /workspace && chown 1000:1000 /workspace
USER 1000:1000

# Keep the default target compatible with the Docker engine's host-UID selection.
FROM sandbox-base AS sandbox

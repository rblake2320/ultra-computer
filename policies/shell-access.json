{
  "version": 1,
  "domain": "shell",
  "defaultEffect": "deny",
  "rules": [
    {
      "id": "shell-deny-dangerous",
      "effect": "deny",
      "actions": ["shell:execute"],
      "commandPatterns": [
        "\\brm\\s+-rf\\b",
        "\\b(curl|wget|nc|netcat|nmap|ssh|scp|rsync)\\b",
        "/dev/(tcp|udp)/",
        "\\b(pip3?|npm)\\s+(install|i)\\b",
        "\\b(sudo|su\\s+-|chown|chmod\\s+.*777|shutdown|reboot|halt|poweroff)\\b",
        "node\\s+(-e|--eval)\\b",
        "python3?\\s+-c\\b",
        "`|\\$\\("
      ],
      "reason": "Dangerous shell, network, privilege, package-install, and inline execution patterns are blocked."
    },
    {
      "id": "shell-safe-read-execute",
      "effect": "allow",
      "actions": ["shell:execute"],
      "commandPatterns": [
        "^(pwd|ls|cat|echo|grep|find|sed|awk|wc|head|tail|sort|uniq)(\\s|$)",
        "^(python3?|node|bash|sh)\\s+\"?[A-Za-z0-9_./\\\\:-]+\"?(\\s+\"?[A-Za-z0-9_./\\\\=:-]+\"?)*$",
        "^npm\\s+(run\\s+)?(test|check|build|audit|verify|smoke:prod)(\\s|$)"
      ],
      "reason": "Only simple local inspection and approved local script/test execution commands are allowed by default."
    }
  ]
}

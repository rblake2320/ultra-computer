# Ultra Computer — environment variables
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── App ─────────────────────────────────────────────────────────────────────
ULTRA_API_KEY=your-api-key-here
ENCRYPTION_KEY=generate-with-npm-run-gen-key

# ── Webhooks ─────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Exposes the app at your configured public hostname (see docs/CLOUDFLARE_SETUP.md)
# Steps:
#   1. Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create a tunnel
#   2. Name: ultra-computer (or any name)
#   3. Public hostname: your-subdomain.your-domain.com → http://app:5000
#   4. Copy the tunnel token below
#   5. Start with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# ── Temporal (set when running worker on host, not in Docker) ─────────────────
TEMPORAL_ADDRESS=localhost:7233
